<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <connectionStrings>
    <add name="SqlServerConnectionString" 
         connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=StudentGrades;Integrated Security=True" 
         providerName="System.Data.SqlClient" />
         
    <add name="SqliteConnectionString" 
         connectionString="Data Source=StudentGrades.db;Version=3;" 
         providerName="System.Data.SQLite" />
  </connectionStrings>
</configuration>
