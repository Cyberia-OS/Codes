<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <connectionStrings>
    <add name="WarehouseString"
         connectionString="Data Source=(localdb)\MSSQLLocalDB; Initial Catalog=Warehouse; Integrated Security=True; TrustServerCertificate=True;" 
         providerName="System.Data.SqlClient" />
  </connectionStrings>
</configuration>
